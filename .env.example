# Copy this file to .env and fill in real values.

# Folder with PDFs and the generated index (chunks.jsonl, embeddings.npy)
DOCUMENT_QA_DATA_DIR=data

# Maximum upload size in megabytes
DOCUMENT_QA_MAX_UPLOAD_MB=10

# Minimum similarity score for the top search result
# Tune it with your eval questions.
DOCUMENT_QA_SEARCH_THRESHOLD=0.6

# OpenRouter model ID. Write the same ID next to eval results
DOCUMENT_QA_LLM_MODEL=google/gemini-3.1-flash-lite

# OpenRouter API key
OPENROUTER_API_KEY="Your_OpenRouter_API_Key"